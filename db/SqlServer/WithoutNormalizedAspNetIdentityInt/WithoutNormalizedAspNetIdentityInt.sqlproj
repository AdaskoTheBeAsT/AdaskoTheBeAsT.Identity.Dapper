<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.0.0" />
  <PropertyGroup>
    <Name>WithoutNormalizedAspNetIdentityInt</Name>
    <!--Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider  Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider-->
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033,CI</ModelCollation>
    <RootNamespace>WithoutNormalizedAspNetIdentityInt</RootNamespace>
    <AssemblyName>WithoutNormalizedAspNetIdentityInt</AssemblyName>
    <TargetDatabaseSet>True</TargetDatabaseSet>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ProjectGuid>{50147b9d-9f88-482e-998f-850bd80bcaee}</ProjectGuid>
    <DefaultCollation>SQL_Latin1_General_CP1_CI_AS</DefaultCollation>
    <DefaultFilegroup>PRIMARY</DefaultFilegroup>
    <DefaultFileStructure>BySchemaAndSchemaType</DefaultFileStructure>
    <NoWarn>$(NoWarn);CA1016;S3904;SA0001</NoWarn>
    <EnableDefaultSqlItems>false</EnableDefaultSqlItems>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="dbo\" />
    <Folder Include="dbo\Tables\" />
  </ItemGroup>
  <ItemGroup>
    <Build Include="dbo\Tables\AspNetRoleClaims.sql" />
    <Build Include="dbo\Tables\AspNetRoles.sql" />
    <Build Include="dbo\Tables\AspNetUserClaims.sql" />
    <Build Include="dbo\Tables\AspNetUserLogins.sql" />
    <Build Include="dbo\Tables\AspNetUserRoles.sql" />
    <Build Include="dbo\Tables\AspNetUsers.sql" />
    <Build Include="dbo\Tables\AspNetUserTokens.sql" />
  </ItemGroup>
  <Target Name="EnsureNuGetRestore" BeforeTargets="PrepareForBuild" Condition="!Exists('$(MSBuildProjectDirectory)\obj\project.assets.json')">
    <Message Importance="high" Text="Running NuGet restore for SQL project $(MSBuildProjectName)..." />
    <Exec Command="dotnet restore $(MSBuildProjectFile)" ContinueOnError="false" />
  </Target>
</Project>
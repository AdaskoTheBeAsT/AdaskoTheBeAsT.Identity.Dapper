<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-10</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Common\*.cs" Link="Common\%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\src\AdaskoTheBeAsT.Identity.Dapper.Shared\RawStringLiteral.cs" Link="Common\RawStringLiteral.cs" />
    <PackageReference Include="Dapper.SqlBuilder" Version="2.1.89" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Npgsql" Version="10.0.2" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
  </ItemGroup>

  <Target Name="RemoveTransitiveAnalyzerStoreReferenceFromCompilation" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <_ResolvedProjectReferencePaths Remove="@(_ResolvedProjectReferencePaths)"
                                      Condition="'%(Filename)' == 'Microsoft.Extensions.Identity.Stores'" />
    </ItemGroup>
  </Target>
</Project>
